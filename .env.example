# STT
SARVAM_API_KEY=

# stubbed, not wired in MVP — see api/stt/elevenlabs.py
ELEVENLABS_API_KEY=

# LLM / embedding (NVIDIA NIM, OpenAI-compatible) — see api/llm/nvidia_client.py
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_EMBED_DIM=2048     # confirmed live: nvidia/nemotron-3-embed-1b returns 2048-dim
VOICE_DEFAULT_BUDGET_MS=35000  # the LLM alone takes 8-25s live (reasoning model) — see api/llm/nvidia_client.py

# retrieval / index
QDRANT_LOCAL_PATH=./ingest/data/qdrant_storage
BM25_INDEX_PATH=./ingest/data/bm25_index
CORPUS_TIER=T0            # T0 | T1 | T2
INDEX_ARTEFACT_ID=dev

# harness
DEFAULT_BUDGET_MS=200
LANGUAGES=en,hi,bn,ta,mr

# api
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
# once the frontend's real deployed URL is known, lock it down instead, e.g.
# CORS_ORIGINS=https://nova-bodhix.vercel.app

# frontend (set on Vercel, public/non-secret)
NEXT_PUBLIC_API_URL=http://localhost:8000
