# secrets
.env
.env.local
.env.*.local
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# node
node_modules/
.next/
out/
*.tsbuildinfo
.vercel
.vite/

# data + model + index artefacts (large, rebuilt from ingest/)
data/
!data/.gitkeep
models/
!models/.gitkeep
indexes/
!indexes/.gitkeep
*.parquet
*.onnx
*.safetensors
*.bin
qdrant_storage/
*.snapshot

# embeddings cache IS committed (sharded parquet) — see
# ingest/export_embeddings.py / ingest/load_cached_embeddings.py. This is
# what lets a fresh clone populate the index without re-calling the
# embedding APIs.
!ingest/embeddings_cache/
!ingest/embeddings_cache/**/*.parquet

# benchmark outputs: results ARE committed (they are the graded evidence),
# but scratch and intermediate runs are not
bench/scratch/
bench/results/*.tmp

# media (videos live on social platforms, not in git)
*.mp4
*.mov
*.wav
*.mp3
!bench/fixtures/**/*.wav

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

/frontend/.env
.env.*
